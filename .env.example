# Meta for Developers > App settings > Basic
META_APP_ID=
META_APP_SECRET=

# Must exactly match the Valid OAuth Redirect URI in your Meta app.
# Local development uses Vite :3000 proxying /auth to Express :3001.
META_REDIRECT_URI=http://localhost:3000/auth/callback
FRONTEND_URL=http://localhost:3000
PORT=3001

# Set these to a Graph API version supported by your Meta app.
META_GRAPH_VERSION=v26.0
META_MARKETING_VERSION=v25.0
